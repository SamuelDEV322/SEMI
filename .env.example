# Local operational profile. Copy to .env only if it does not already exist.
# This public development placeholder is not a production secret.
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=local-development-change-before-sharing
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,testserver
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Keep existing data. Changing the profile never deletes or relabels SQLite rows.
SEMI_DATABASE=demo.sqlite3
# Server startup configuration only; no browser/API source switch exists.
SEMI_MODE=operational
SEMI_LIDAR_SOURCE=real
SEMI_DEV_TOOLS=0
# Optional USB reader authorization. Does NOT start a device or enable vehicle motion.
SEMI_LIDAR_DIAGNOSTICS=0
# Empty uses backend/runtime/lidar-latest.json; reader and Django must use the same file.
SEMI_LIDAR_SPOOL=
# Vite development/preview proxy. Never put secrets in VITE_* variables.
VITE_BACKEND_TARGET=http://127.0.0.1:8000
