# Local demonstration only. Copy to .env if it does not already exist.
# This public development placeholder is not a production secret.
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=local-demo-change-before-sharing
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,testserver
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SEMI_DATABASE=demo.sqlite3
# Only mock is accepted; no setting enables physical vehicle motion.
SEMI_PROVIDER=mock
# Diagnostic USB reader authorization. Does not start or open anything.
SEMI_LIDAR_DIAGNOSTICS=0
# Optional atomic latest-only IPC file; default backend/runtime/lidar-latest.json
SEMI_LIDAR_SPOOL=
# Vite development/preview proxy. Never put secrets in VITE_* variables.
VITE_BACKEND_TARGET=http://127.0.0.1:8000
